# ---- Storage ----
# local = save PDFs in ./uploads (no AWS needed)   s3 = upload PDFs to AWS S3
STORAGE_MODE=local

# ---- AWS (only needed when STORAGE_MODE=s3) ----
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-regflow-bucket-name
# Leave these commented out if you use `aws configure` (~/.aws/credentials) or an IAM role.
# boto3 reads them from the environment automatically; they are never used in code.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Gemini ----
# Get a key at https://aistudio.google.com/apikey
# Without a key the app still runs, using Python checks only (results flagged for review).
GEMINI_API_KEY=your_gemini_api_key_here
# "-latest" aliases always point to a current model, so the app does not break when a version is retired.
# flash-lite is fast and has the most generous free quota; use gemini-flash-latest for the larger model.
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Optional ----
# MAX_UPLOAD_MB=10
